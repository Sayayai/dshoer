# ==============================================================================
# Git 忽略文件配置 (.gitignore)
# ==============================================================================

# 1. 敏感信息与环境变量文件 (绝对不可提交到公共 GitHub 仓库)
.env
.env.local
.env.*.local
*.key
*.pem
id_rsa*
known_hosts*

# 2. 本地代码、挂载目录与数据缓存
workspace/
dsh/
fun/

# 4. 临时文件与日志
*.log
tmp/
temp/
cache/
dist/
build/

# 5. 系统与编辑器缓存
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
