# ==============================================================================
# Git 忽略文件配置 (.gitignore)
# ==============================================================================

# 1. 敏感信息与环境变量文件 (绝对不可提交到公共 GitHub 仓库)
.env
.env.local
.env.*.local
*.key
*.pem
id_rsa*
known_hosts*

# 2. 本地代码与工作区临时文件
workspace/*
!workspace/README.md
!workspace/.gitkeep

# 3. DSH 配置与应用运行数据 (本地 API Key、会话历史与缓存，避免泄露至公共仓库)
dsh/*
!dsh/README.md
!dsh/.gitkeep

# 4. 临时文件与日志
*.log
tmp/
temp/
cache/
dist/
build/

# 5. 系统与编辑器缓存
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
