# ==============================================================================
# 开发环境容器环境变量配置 (.env)
# 复制本文件为 .env 并按需修改: cp .env.example .env
# ==============================================================================

# SSH 访问端口 (默认 2222，本地 VS Code Remote-SSH 连接此端口)
SSH_PORT=2222

# 容器内 root 用户登录密码 (默认 dev123456)
ROOT_PASSWORD=dev123456

# 可选: 填入您本地电脑的 id_rsa.pub 内容，实现 VS Code 免密一键直连
SSH_PUBLIC_KEY=
