# ==============================================================================
# 开发环境容器环境变量配置 (.env)
# 复制本文件为 .env 并按需修改: cp .env.example .env
# ==============================================================================

# SSH 访问端口 (默认 2222，本地 VS Code Remote-SSH 连接此端口)
SSH_PORT=51234

# 必填: 填入本地电脑公钥内容 (例如 ~/.ssh/id_rsa.pub 或 id_ed25519.pub)，用于 VS Code 免密直连
# 注意: 环境已彻底禁用密码登录，必须配置此公钥才能成功连接
SSH_PUBLIC_KEY=""

# ==============================================================================
# 容器资源限制配置 (限制在 70% CPU 与 7G 内存)
# ==============================================================================
# CPU 限制计算公式: 宿主机总逻辑核心数 * 70% (例如 4核填 2.8，8核填 5.6，16核填 11.2)
CPU_LIMIT=1.6
MEM_LIMIT=7G
MEM_RESERVATION=2G

